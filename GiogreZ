local BASE64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local BASE64_LOOKUP = {}
for index = 1, #BASE64_CHARS do
	BASE64_LOOKUP[string.byte(BASE64_CHARS, index)] = index - 1
end

local function decodeBase64(text)
	local bytes = {}
	local count = 0
	local buffer = 0
	local bits = 0
	for index = 1, #text do
		local value = BASE64_LOOKUP[string.byte(text, index)]
		if value then
			buffer = buffer * 64 + value
			bits = bits + 6
			if bits >= 8 then
				bits = bits - 8
				local divisor = 2 ^ bits
				local byte = math.floor(buffer / divisor)
				buffer = buffer - byte * divisor
				count = count + 1
				bytes[count] = string.char(byte)
			end
		end
	end
	return table.concat(bytes)
end

local function loadEmbeddedImage(fileName, base64Text)
	if typeof(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then
		return nil
	end
	local ok, result = pcall(function()
		writefile(fileName, decodeBase64(base64Text))
		return getcustomasset(fileName)
	end)
	if ok and type(result) == "string" and result ~= "" then
		return result
	end
	return nil
end

