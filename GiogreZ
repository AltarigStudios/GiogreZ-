-- Screen fitting and dragging
local function getViewport()
	local viewport = gui.AbsoluteSize
	if viewport.X < 1 or viewport.Y < 1 then
		local camera = Workspace.CurrentCamera
		viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	end
	return viewport
end

local function getFitScale()
	local viewport = getViewport()
	local fit = math.min(viewport.X * 0.85 / DESIGN_W, viewport.Y * 0.8 / DESIGN_H)
	if UserInputService.TouchEnabled then
		fit = fit * 0.9
	end
	return math.clamp(fit, 0.35, 1)
end

local function getWindowSize()
	return Vector2.new(DESIGN_W, DESIGN_H) * getFitScale()
end

local function clampPosition(position, size, anchor)
	local viewport = getViewport()
	local x = position.X.Scale * viewport.X + position.X.Offset
	local y = position.Y.Scale * viewport.Y + position.Y.Offset
	local minX = size.X * anchor.X
	local minY = size.Y * anchor.Y
	x = math.clamp(x, minX, math.max(minX, viewport.X - size.X * (1 - anchor.X)))
	y = math.clamp(y, minY, math.max(minY, viewport.Y - size.Y * (1 - anchor.Y)))
	return UDim2.fromOffset(x, y)
end

local function makeDraggable(handle, target, getSize, onTap)
	local active = false
	local moved = false
	local startPointer = Vector2.zero
	local startPosition = target.Position

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			active = true
			moved = false
			startPointer = Vector2.new(input.Position.X, input.Position.Y)
			startPosition = target.Position
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if not active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - startPointer
			if delta.Magnitude > 6 then
				moved = true
			end
			if moved then
				local wanted = UDim2.new(
					startPosition.X.Scale, startPosition.X.Offset + delta.X,
					startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
				)
				target.Position = clampPosition(wanted, getSize(), target.AnchorPoint)
			end
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if not active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			active = false
			if not moved and onTap then
				onTap()
			end
		end
	end))
end

