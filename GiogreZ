-- Studs texture: tiled picture when available, otherwise drawn with small squares
local function addStuds(parent, inset, cols, rows, cell, stud, color, transparency, imageTint, imageTransparency)
	if STUDS_IMAGE then
		local layer = create("ImageLabel", {
			Name = "Studs",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(inset, inset),
			Size = UDim2.new(1, -inset * 2, 1, -inset * 2),
			Image = STUDS_IMAGE,
			ImageColor3 = imageTint,
			ImageTransparency = imageTransparency,
			ScaleType = Enum.ScaleType.Tile,
			TileSize = UDim2.fromOffset(cell * 4, cell * 4),
		}, parent)
		create("UICorner", {CornerRadius = UDim.new(0, 8)}, layer)
		return layer
	end
	local layer = create("Frame", {
		Name = "Studs",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(inset, inset),
		Size = UDim2.new(1, -inset * 2, 1, -inset * 2),
	}, parent)
	local gap = (cell - stud) / 2
	for row = 0, rows - 1 do
		for col = 0, cols - 1 do
			local square = create("Frame", {
				BackgroundColor3 = color,
				BackgroundTransparency = transparency,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(col * cell + gap, row * cell + gap),
				Size = UDim2.fromOffset(stud, stud),
			}, layer)
			create("UICorner", {CornerRadius = UDim.new(0, 3)}, square)
		end
	end
	return layer
end

local globalConnections = {}

local function track(connection)
	table.insert(globalConnections, connection)
	return connection
end

local function newScope()
	local items = {}
	local scope = {}
	function scope.add(item)
		table.insert(items, item)
		return item
	end
	function scope.clean()
		for index = #items, 1, -1 do
			local item = items[index]
			items[index] = nil
			local kind = typeof(item)
			if kind == "RBXScriptConnection" then
				item:Disconnect()
			elseif kind == "Instance" then
				item:Destroy()
			elseif kind == "function" then
				pcall(item)
			end
		end
	end
	return scope
end

