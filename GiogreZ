end

local function makeButton(parent, text, colors, size, position, maxTextSize)
	local button = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = size,
		Position = position,
	}, parent)
	create("UICorner", {CornerRadius = UDim.new(0, 8)}, button)
	create("UIStroke", {Thickness = 3, Color = BLACK, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, button)
	addGradient(button, colors)
	addShine(button)
	local label = create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -8, 0.8, 0),
		Text = text,
		TextScaled = true,
		ZIndex = 3,
	}, button)
	styleText(label)
	create("UITextSizeConstraint", {MaxTextSize = maxTextSize or 20, MinTextSize = 8}, label)

	local idle = UDim2.fromScale(0.5, 0.5)
	local pressed = UDim2.new(0.5, 0, 0.5, 2)
	button.MouseButton1Down:Connect(function()
		tween(button, PRESS_INFO, {BackgroundColor3 = Color3.fromRGB(165, 165, 165)})
		label.Position = UDim2.new(label.Position.X.Scale, label.Position.X.Offset, 0.5, 2)
