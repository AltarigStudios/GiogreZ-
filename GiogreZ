------------------------------------------------------------------------
-- LIBRARY LOGIC
------------------------------------------------------------------------

local currentCategory = "All"
local isOpen = false
local statusToken = 0
local tabs = {}

local function setStatus(message, kind)
	statusToken = statusToken + 1
	local token = statusToken
	statusLabel.Text = message
	statusLabel.TextColor3 = STATUS_COLORS[kind] or WHITE
	task.delay(5, function()
		if token == statusToken then
			statusLabel.Text = getDefaultStatus()
			statusLabel.TextColor3 = WHITE
		end
	end)
end

local function currentOption(def)
	if def.options then
		return def.options[def.optionIndex]
	end
	return nil
end

local function refreshCard(def)
	local ui = def.ui
	if not ui then
		return
	end
	local stateText
	if def.kind == "toggle" then
		if def.running then
			recolor(ui.runButton, COLORS.red)
			ui.runLabel.Text = "STOP"
			stateText = '<font color="#7CFF3C">● ON</font>'
		else
			recolor(ui.runButton, COLORS.green)
			ui.runLabel.Text = "START"
			stateText = '<font color="#E0E0E0">● OFF</font>'
		end
	else
		recolor(ui.runButton, COLORS.green)
		ui.runLabel.Text = "RUN"
		stateText = '<font color="#FFFFFF">● READY</font>'
	end
	recolor(def.card, def.running and RUNNING_COLORS or COLORS.yellow)
	ui.tag.Text = def.category .. "   " .. stateText
	local option = currentOption(def)
	if ui.optionLabel and option then
		ui.optionLabel.Text = option.text
	end
end

local function stopScript(def)
	if def.scope then
		def.scope.clean()
	end
	def.scope = nil
	def.running = false
end

local function startScript(def)
	local scope = newScope()
	local option = currentOption(def)
	local ok, result, message = pcall(def.start, scope, option and option.value)
	if not ok or result == false then
		scope.clean()
		def.scope = nil
		def.running = false
		local reason = message
		if not ok then
			reason = result
		end
		setStatus(def.name .. ": " .. tostring(reason or "failed"), "error")
		return false
	end
	def.scope = scope
	def.running = true
	setStatus(message or (def.name .. " enabled"), "ok")
	return true
end

local function activate(def)
	if def.kind == "action" then
		local option = currentOption(def)
		local ok, result, message = pcall(def.run, option and option.value)
		if not ok then
			setStatus(def.name .. " failed: " .. tostring(result), "error")
		elseif result == false then
			setStatus(message or (def.name .. " failed"), "error")
		else
			setStatus(message or (def.name .. " done"), "ok")
		end
	elseif def.running then
		stopScript(def)
		setStatus(def.name .. " stopped", "info")
	else
		startScript(def)
	end
	refreshCard(def)
end

local function cycleOption(def)
	if not def.options then
		return
	end
	def.optionIndex = def.optionIndex % #def.options + 1
	if def.kind == "toggle" and def.running then
		stopScript(def)
		startScript(def)
	else
		setStatus(def.name .. ": " .. def.options[def.optionIndex].text, "info")
	end
	refreshCard(def)
end

local function stopAll()
	local count = 0
	for _, def in ipairs(scripts) do
		if def.running then
			stopScript(def)
			refreshCard(def)
			count = count + 1
		end
	end
	if count == 0 then
		setStatus("Nothing is running", "info")
	else
		setStatus("Stopped " .. tostring(count) .. " script(s)", "ok")
	end
end

local function applyFilter()
	local query = string.lower(searchBox.Text)
	local shown = 0
	for _, def in ipairs(scripts) do
		local inCategory = currentCategory == "All" or def.category == currentCategory
		local inSearch = query == ""
			or string.find(string.lower(def.name), query, 1, true) ~= nil
			or string.find(string.lower(def.desc), query, 1, true) ~= nil
		local visible = inCategory and inSearch
		if def.card then
			def.card.Visible = visible
		end
		if visible then
			shown = shown + 1
		end
	end
	emptyLabel.Visible = shown == 0
end

local function selectCategory(name)
	currentCategory = name
	for category, tab in pairs(tabs) do
		if category == name then
			recolor(tab, COLORS.green)
		else
			recolor(tab, COLORS.yellow)
		end
	end
	scroller.CanvasPosition = Vector2.zero
	applyFilter()
	for _, def in ipairs(scripts) do
		if def.ui and def.card.Visible then
			def.ui.pop.Scale = 0.86
			tween(def.ui.pop, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
		end
	end
end

local function setOpen(state)
	isOpen = state
	if state then
		main.Visible = true
		main.Position = clampPosition(main.Position, getWindowSize(), main.AnchorPoint)
		tween(mainScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = getFitScale()})
	else
		local closing = tween(mainScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0})
		closing.Completed:Once(function()
			if not isOpen then
				main.Visible = false
			end
		end)
	end
	
end

