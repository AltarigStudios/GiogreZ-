register({
	name = "Fly",
	category = "Movement",
	kind = "toggle",
	persist = true,
	desc = "Fly toward where the camera looks. PC: Space up, Shift down.",
	options = makeOptions("Speed", {40, 70, 100, 150}),
	start = function(scope, speed)
		local humanoid = getHumanoid()
		local root = getRoot()
		if not humanoid or not root then
			return false, "Character not ready"
		end
		local velocity = create("BodyVelocity", {
			MaxForce = Vector3.new(1e9, 1e9, 1e9),
			Velocity = Vector3.zero,
		}, root)
		local gyro = create("BodyGyro", {
			MaxTorque = Vector3.new(1e9, 1e9, 1e9),
			P = 9000,
			CFrame = root.CFrame,
		}, root)
		local originalPlatform = humanoid.PlatformStand
		humanoid.PlatformStand = true
		scope.add(velocity)
		scope.add(gyro)
		scope.add(function()
			humanoid.PlatformStand = originalPlatform
		end)
		scope.add(RunService.RenderStepped:Connect(function()
			local camera = Workspace.CurrentCamera
			if not camera or not root.Parent then
				return
			end
			local look = camera.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			local move = humanoid.MoveDirection
			local push = move * speed
			if flat.Magnitude > 0.01 then
				flat = flat.Unit
				if move.Magnitude > 0 then
					push = push + Vector3.new(0, look.Y * move:Dot(flat) * speed, 0)
				end
				gyro.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				push = push + Vector3.new(0, speed, 0)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				push = push - Vector3.new(0, speed, 0)
			end
			velocity.Velocity = push
		end))
		return true, "Fly enabled"
	end,
})

register({
	name = "Noclip",
