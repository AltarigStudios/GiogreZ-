			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					touched[part] = true
					part.CanCollide = false
				end
			end
		end))
		scope.add(function()
			for part in pairs(touched) do
				if part.Parent then
					part.CanCollide = true
				end
			end
		end)
		return true, "Noclip enabled"
	end,
})

