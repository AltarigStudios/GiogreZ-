	local optionLabel
	if def.options then
		runButton, runLabel = makeButton(card, "START", COLORS.green, UDim2.fromOffset(88, 34), UDim2.new(1, -98, 0, 8), 20)
		local optionButton
		optionButton, optionLabel = makeButton(card, "", COLORS.blue, UDim2.fromOffset(88, 28), UDim2.new(1, -98, 0, 46), 16)
		optionButton.Activated:Connect(function()
			cycleOption(def)
		end)
	else
		runButton, runLabel = makeButton(card, "START", COLORS.green, UDim2.fromOffset(88, 42), UDim2.new(1, -98, 0.5, -21), 20)
	end
	runButton.Activated:Connect(function()
		activate(def)
	end)

	def.card = card
	def.ui = {
		runButton = runButton,
		runLabel = runLabel,
		optionLabel = optionLabel,
		tag = tag,
		pop = pop,
	}
	refreshCard(def)
end

for index, def in ipairs(scripts) do
	buildCard(def, index)
end

for index, category in ipairs(CATEGORIES) do
	local info = TAB_INFO[category]
	local tab, tabLabel = makeButton(tabBar, info.label, COLORS.yellow, UDim2.fromOffset(info.width, 34), UDim2.new(), 16)
	if ICONS_IMAGE then
		tabLabel.AnchorPoint = Vector2.new(1, 0.5)
		tabLabel.Position = UDim2.new(1, -6, 0.5, 0)
		tabLabel.Size = UDim2.new(1, -34, 0.8, 0)
		addIcon(tab, ICON_SLOTS[category], 22, UDim2.new(0, 7, 0.5, -11))
	end
	tab.LayoutOrder = index
	tab.Activated:Connect(function()
		selectCategory(category)
	end)
	tabs[category] = tab
end

------------------------------------------------------------------------
-- EVENTS
------------------------------------------------------------------------

closeButton.Activated:Connect(function()
	setOpen(false)
end)

makeDraggable(openButton, openButton, function()
	return OPEN_SIZE
end, function()
	setOpen(not isOpen)
end)

clearButton.Activated:Connect(function()
	searchBox.Text = ""
end)

stopAllButton.Activated:Connect(stopAll)

searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	if isOpen then
		mainScale.Scale = getFitScale()
		main.Position = clampPosition(main.Position, getWindowSize(), main.AnchorPoint)
	end
	openButton.Position = clampPosition(openButton.Position, OPEN_SIZE, openButton.AnchorPoint)
end)

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.RightControl then
		setOpen(not isOpen)
	end
end))

-- Restart scripts that depend on the character after respawning
track(player.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	for _, def in ipairs(scripts) do
		if def.running and def.persist then
			stopScript(def)
			startScript(def)
			refreshCard(def)
		end
	end
end))

-- Clean everything if the GUI is destroyed
gui.Destroying:Connect(function()
	for _, def in ipairs(scripts) do
		stopScript(def)
	end
	for _, connection in ipairs(globalConnections) do
		connection:Disconnect()
	end
	table.clear(globalConnections)
end)

